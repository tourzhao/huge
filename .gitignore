#revdep
revdep/*

# old package
/_old_package/*

# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# produced vignettes
vignettes/*.html
vignettes/vignettes.pdf
inst/doc/huge-content.pdf
# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth
# knitr and R markdown default cache directories
/*_cache/
/cache/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
# Shiny token, see https://shiny.rstudio.com/articles/shinyapps.html
rsconnect/
.Rproj.user
^.*\.Rproj$
^\.Rproj\.user$
# Prerequisites
*.d
# Compiled Object files
*.slo
*.lo
*.o
*.obj
# Precompiled Headers
*.gch
*.pch
# Compiled Dynamic libraries
*.so
*.dylib
*.dll
# Fortran module files
*.mod
*.smod
# Compiled Static libraries
*.lai
*.la
*.a
*.lib
# Executables
*.exe
*.out
*.app
/doc/
/Meta/

# macOS system files
.DS_Store
**/.DS_Store

# Claude Code
.claude/

# Auto-generated by configure
config.status
config.log
autom4te.cache/

# R library cache
.Rlib/

# Python dependency cache
.pydeps/

# Python build artifacts
python-package/build/
python-package/dist/
python-package/pyhuge.egg-info/
python-package/**/__pycache__/
python-package/.pytest_cache/
python-package/.mplconfig/
python-package/site/
python-package/*.Rcheck/
python-package/*.tar.gz
python-package/Rplots.pdf
python-package/parity_report.json

# Benchmark outputs
benchmark/*.json
benchmark/*.rds
benchmark/*_report.md
benchmark/README.md
benchmark/perf_opt*.R
benchmark/active_set_baseline/runs/
benchmark/active_set_baseline/baseline/
benchmark/active_set_baseline/data/
benchmark/cmp16/
benchmark/cmp16_lib/

